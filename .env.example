# .env ka template. Asli `.env` git me KABHI nahi jaata (.gitignore).
# Setup: `./dev init` ye file copy karke random password daal deta hai.
# Is file me sirf SECRETS + CONNECTION settings hain (CLAUDE.md section 4).
# Versions -> versions.env | timeouts/limits jaise tunables -> config files. Yahan mix mat karo.

# --- App environment (ADR 0017) ---
# Sirf environment ka NAAM: development | test | production. Isse tunables ka override set chunta hai.
# Koi tunable value yahan nahi aati.
APP_ENV=development

# --- PostgreSQL: admin user (migrations, bootstrap, test seeding). App isse KABHI connect nahi karta. ---
POSTGRES_USER=marky
POSTGRES_PASSWORD=__set_by_dev_init__
POSTGRES_DB=marky

# --- PostgreSQL: app login role `marky_app` ka password (ADR 0018) ---
# Role migration banata hai (bina password); `./dev db bootstrap` ye password set karta hai.
APP_DB_PASSWORD=__set_by_dev_init__

# --- AI key encryption master key (ADR 0025) ---
# Teams ki AI provider API keys isse AES-256-GCM me encrypt hoti hain. 32 random bytes, base64.
# Ye key kho gayi to saari saved team keys bekaar (teams ko dobara daalni padegi). Kabhi commit mat karna.
AI_KEY_ENCRYPTION_KEY=__set_by_dev_init_key32__

# --- Test database (ADR 0020): `./dev test` ise banata, migrate karta aur use karta hai ---
TEST_POSTGRES_DB=marky_test

# --- Host ports (sirf 127.0.0.1 par khulte hain) ---
# Clash ho to yahan badlo; container ke andar ke ports par koi asar nahi padta.
POSTGRES_HOST_PORT=5432
VALKEY_HOST_PORT=6379
WEB_PORT=3000
