# Image / tool version pins (ADR 0005, 0015).
# Ye SECRETS NAHI hain, isliye git me committed hain. Secrets/connection values `.env` me jaate hain, yahan kabhi nahi.
# Upgrade karna ho to sirf yahan version badlo, phir `./dev up` (image rebuild hogi).
# Pin date: 2026-11-09 (us din ke latest stable).

# Node.js 26 LTS, Debian trixie-slim base (ADR 0010). Format: <version>-<debian variant>
NODE_IMAGE_TAG=26.13.0-trixie-slim

# pnpm (ADR 0002). Dev image ke andar install hota hai.
PNPM_VERSION=12.18.0

# PostgreSQL (ADR 0001). Official image, Debian based.
POSTGRES_VERSION=18.6

# Valkey, Redis-compatible (ADR 0009).
VALKEY_VERSION=9.1.3

# dbmate migration runner (ADR 0011).
DBMATE_VERSION=2.38.0
