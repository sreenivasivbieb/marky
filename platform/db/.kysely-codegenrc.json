{
  "dialect": "postgres",
  "url": "env(MIGRATION_DATABASE_URL)",
  "outFile": "src/generated/database.ts",
  "excludePattern": "public.schema_migrations",
  "customImports": {
    "MembershipRole": "../value-lists.ts",
    "ProductPlan": "../value-lists.ts",
    "DocumentState": "../value-lists.ts",
    "BlockType": "../value-lists.ts",
    "ChangeOp": "../value-lists.ts",
    "ChangeStatus": "../value-lists.ts",
    "ChangeAuthorType": "../value-lists.ts",
    "DecisionStatus": "../value-lists.ts",
    "AuditActorType": "../value-lists.ts",
    "AuditAction": "../value-lists.ts",
    "AuditTargetType": "../value-lists.ts",
    "AiProvider": "../value-lists.ts",
    "AiRequestPurpose": "../value-lists.ts",
    "AiRequestStatus": "../value-lists.ts",
    "ChatRole": "../value-lists.ts",
    "AiMode": "../value-lists.ts"
  },
  "overrides": {
    "columns": {
      "memberships.role": "MembershipRole",
      "products.plan": "Generated<ProductPlan>",
      "documents.state": "Generated<DocumentState>",
      "blocks.type": "BlockType",
      "changes.op": "ChangeOp",
      "changes.status": "Generated<ChangeStatus>",
      "changes.author_type": "ChangeAuthorType",
      "decisions.status": "Generated<DecisionStatus>",
      "audit_events.actor_type": "AuditActorType",
      "audit_events.action": "AuditAction",
      "audit_events.target_type": "AuditTargetType",
      "ai_credentials.provider": "AiProvider",
      "ai_requests.provider": "AiProvider",
      "ai_requests.purpose": "AiRequestPurpose",
      "ai_requests.status": "AiRequestStatus",
      "chat_turns.role": "ChatRole",
      "chat_turns.mode": "AiMode"
    }
  }
}
