{
  "name": "@marky/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres access: Kysely client, actor/RLS transactions, generated types. Migrations: ./migrations (dbmate). ADR 0008, 0018, 0020.",
