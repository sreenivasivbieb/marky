    "db:types": "kysely-codegen --config-file .kysely-codegenrc.json"
  },
  "dependencies": {
    "kysely": "0.29.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "zod": "4.6.7"
  }
}
