#!/usr/bin/env bash
# ./dev: Marky ka dev wrapper (ADR 0005, 0015).
# Host par sirf docker + git chahiye. Har tool (node, pnpm, psql, dbmate) container ke andar chalta hai.

set -euo pipefail   # error par ruko (-e), undefined variable = error (-u), pipe ka koi bhi fail = fail (pipefail)

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

VERSIONS_FILE="versions.env"
ENV_FILE=".env"
ENV_TEMPLATE=".env.example"
PASSWORD_PLACEHOLDER="__set_by_dev_init__"
PASSWORD_BYTES=24   # random password ki lambai (bytes); base64 ke baad ~32 characters

# App ka DB login role. Source of truth: platform/db/migrations (roles migration). Ye naam wahan se match karna chahiye.
APP_DB_ROLE="marky_app"

# Container host user ki UID:GID se chale, taaki bani hui files aapki hon, root ki nahi.
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"
export HOST_UID HOST_GID

die() { echo "dev: $*" >&2; exit 1; }

compose() {
  [[ -f "$ENV_FILE" ]] || die "$ENV_FILE nahi mila. Pehle './dev init' chalao."
  docker compose --env-file "$VERSIONS_FILE" --env-file "$ENV_FILE" "$@"
}

# Terminal interactive ho to TTY do, warna (scripts/CI me) -T.
exec_flags() { if [[ -t 0 && -t 1 ]]; then echo ""; else echo "-T"; fi; }

cmd_init() {
  if [[ -f "$ENV_FILE" ]]; then
    echo "$ENV_FILE pehle se hai; kuch nahi badla."
    return
  fi
  # Har placeholder ko ALAG random password milta hai (admin aur app ka password kabhi same nahi).
  # Characters sirf A-Z a-z 0-9, taaki URL me bina encoding ke chal sake.
  umask 077   # nayi file sirf aap padh sako (600)
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == *"$PASSWORD_PLACEHOLDER"* ]]; then
      line="${line//$PASSWORD_PLACEHOLDER/$(random_secret)}"
    fi
    printf '%s\n' "$line"
  done < "$ENV_TEMPLATE" > "$ENV_FILE"
  echo "$ENV_FILE bana diya (har secret ka alag random password). Ab './dev up' chalao."
}

random_secret() { head -c "$PASSWORD_BYTES" /dev/urandom | base64 | tr -d '/+=\n'; }

# marky_app role ka password .env se set karo (ADR 0018). Idempotent: kitni baar bhi chalao.
# Password psql variable se jaata hai (stdin script), command line/logs me nahi dikhta.
cmd_db_bootstrap() {
  compose exec -T postgres sh -c \
    'psql -v ON_ERROR_STOP=1 -v app_role="$1" -v app_password="$APP_DB_PASSWORD" -U "$POSTGRES_USER" -d "$POSTGRES_DB" -q' \
    sh "$APP_DB_ROLE" <<'SQL'
ALTER ROLE :"app_role" WITH PASSWORD :'app_password';
SQL
  echo "bootstrap: $APP_DB_ROLE ka password set ho gaya."
}

# Test DB taiyaar karo (ADR 0020): bana nahi hai to banao, migrations chalao, bootstrap. Phir tests.
cmd_test() {
  compose exec -T postgres sh -c '
    psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "SELECT 1 FROM pg_database WHERE datname = '"'"'$1'"'"'" | grep -q 1 \
      || createdb -U "$POSTGRES_USER" "$1"' sh "$(env_value TEST_POSTGRES_DB)"
  compose run --rm --quiet-pull dbmate --env TEST_DATABASE_URL --no-dump-schema up
  cmd_db_bootstrap
  compose exec $(exec_flags) dev pnpm test "$@"
}

# .env se ek value padho (sirf non-secret values ke liye use karo).
env_value() { grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2-; }

cmd_help() {
  cat <<'EOF'
Usage: ./dev <command> [args]

Setup
  init                 .env.example se .env banao (random DB password)
  up                   sab services build + start karo (healthy hone tak wait)
  down                 services band karo (data volumes bache rehte hain)
  reset                services band + DB/Valkey data DELETE (confirm poochhega)
  ps | logs [svc]      status / logs dekho

Code
  pnpm <args>          dev container me pnpm   (jaise: ./dev pnpm install)
  test [vitest args]   test DB taiyaar karo (create + migrate + bootstrap), phir saare tests
  run <cmd...>         dev container me koi bhi command
  sh                   dev container ka shell

Database
  db <dbmate args>     migrations (jaise: ./dev db new create_products | up | rollback | status)
  db bootstrap         marky_app role ka password .env se set karo (migrate ke baad ek baar)
  psql [args]          Postgres shell (admin user)
  valkey-cli [args]    Valkey shell
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    init)        cmd_init ;;
    up)          compose up --detach --build --wait ;;
    down)        compose down ;;
    reset)
      read -r -p "Saara local DB + Valkey data delete hoga. Pakka? (yes/no) " answer
      [[ "$answer" == "yes" ]] || die "cancel kiya"
      compose down --volumes ;;
    ps)          compose ps ;;
    logs)        compose logs --follow "$@" ;;
    pnpm)        compose exec $(exec_flags) dev pnpm "$@" ;;
    test)        cmd_test "$@" ;;
    run)         compose exec $(exec_flags) dev "$@" ;;
    sh)          compose exec dev bash ;;
    db)
      if [[ "${1:-}" == "bootstrap" ]]; then cmd_db_bootstrap
      else compose run --rm --quiet-pull dbmate "$@"; fi ;;
    psql)        compose exec $(exec_flags) postgres sh -c 'exec psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" "$@"' psql "$@" ;;
    valkey-cli)  compose exec $(exec_flags) valkey valkey-cli "$@" ;;
    help|-h|--help) cmd_help ;;
    *)           cmd_help; die "unknown command: $cmd" ;;
  esac
}

main "$@"
